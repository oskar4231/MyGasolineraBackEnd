{
  "name": "mygasolinera-backend",
  "version": "1.0.0",
  "description": "Backend para MyGasolinera con Node.js",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "sincronizar": "node Frontend/Gasolineras/scripts/sincronizarGasolineras.js",
    "sinc-gasolineras": "node Frontend/Gasolineras/scripts/sincronizarGasolineras.js",
    "start-with-sync": "npm run sync-gasolineras && node server.js",
    "start:tunnel": "node Backend/scripts/startWithTunnel.js",
    "start:tunnel:linux": "PLATFORM=linux node Backend/scripts/startWithTunnel.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "gasolinera",
    "api",
    "nodejs"
  ],
  "author": "Tu nombre",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "nodemailer": "^7.0.11",
    "uuid": "^13.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  }
}